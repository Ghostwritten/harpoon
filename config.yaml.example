# Harpoon (hpn) Configuration File Example
# Copy this file to ~/.hpn/config.yaml or /etc/hpn/config.yaml

# Default registry for push operations
registry: registry.k8s.local

# Default project namespace
project: library

# Proxy configuration
proxy:
  http: http://192.168.21.101:7890
  https: http://192.168.21.101:7890
  enabled: true

# Container runtime settings
runtime:
  preferred: docker  # docker, podman, nerdctl, or skopeo
  auto_fallback: false  # if true, use another available runtime when preferred is unavailable
  timeout: 5m
  retry:
    max_attempts: 3
    delay: 1s
    max_delay: 30s
  # extra_args:  # optional passthrough to underlying runtime (docker/podman/nerdctl/skopeo)
  #   pull: ["--tls-verify=false"]
  #   save: []
  #   push: []

# Logging configuration
logging:
  level: info        # debug, info, warn, error
  format: text       # text or json
  file: ./hpn.log    # log file path (optional)
  console: true      # output to console
  timestamp: true    # include timestamps
  colors: true       # colored output

# Parallel processing settings
parallel:
  max_workers: 5     # maximum concurrent operations
  auto_adjust: true  # automatically adjust based on system resources

# Default paths for save and load operations
paths:
  save_path: ./images  # Default directory for saving images (tar files)
  load_path: ./images  # Default directory for loading images (tar files)